    match /videos/{videoId} {
      allow get: if isSignedIn() && isValidId(videoId) && (resource == null || resource.data.visibility == 'public');
      allow list: if isSignedIn() && resource.data.visibility == 'public';
      allow create: if isVerified() && isValidId(videoId)
        && isValidVideo(incoming())
