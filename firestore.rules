      allow delete: if isVerified() && isValidId(videoId) && (existing().authorUid == request.auth.uid || isAdmin());

      match /likes/{likerUid} {
        allow get: if isSignedIn() && isValidId(videoId) && isValidId(likerUid) && (resource == null || existing().uid is string);
