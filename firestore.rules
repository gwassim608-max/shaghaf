        allow update: if false;
        allow delete: if isVerified() && isValidId(clanId) && isValidId(msgId) && (
          existing().authorUid == request.auth.uid
          || get(/databases/$(database)/documents/clans/$(clanId)).data.ownerUid == request.auth.uid
          || (exists(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid))
