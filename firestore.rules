    match /dms/{threadId} {
      allow get: if isVerified() && isValidId(threadId) && (resource == null || request.auth.uid in resource.data.participants || isAdmin());
      allow list: if isVerified() && request.auth.uid in resource.data.participants;
      allow create: if isVerified() && isValidId(threadId)
        && isValidDmThread(incoming())
        && request.auth.uid in incoming().participants
        && (!('isGroup' in incoming()) || incoming().isGroup == false || incoming().creatorUid == request.auth.uid)
        && (notChatMuted() || isAdmin());
      allow update: if isVerified() && isValidId(threadId)
        && isValidDmThread(incoming())
        && request.auth.uid in existing().participants
        && (notChatMuted() || isAdmin())
        && (
          (
            incoming().participants == existing().participants
            && incoming().diff(existing()).affectedKeys().hasOnly(['lastMessage', 'updatedAt'])
