      allow list: if isVerified() && (
        resource.data.buyerUid == request.auth.uid || resource.data.sellerUid == request.auth.uid || isAdmin()
      );
      allow create: if isVerified() && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().buyerUid == request.auth.uid
        && incoming().buyerUid != incoming().sellerUid
        && incoming().status == 'escrow'
        && !('rating' in incoming())
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/services/$(incoming().serviceId))
        && incoming().sellerUid == get(/databases/$(database)/documents/services/$(incoming().serviceId)).data.sellerUid
        && incoming().price == get(/databases/$(database)/documents/services/$(incoming().serviceId)).data.price
        && notBanned();
      allow update: if isVerified() && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().buyerUid == existing().buyerUid
        && incoming().sellerUid == existing().sellerUid
        && incoming().serviceId == existing().serviceId
        && incoming().price == existing().price
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin()
          || (
            existing().sellerUid == request.auth.uid
            && existing().status == 'escrow'
            && incoming().status == 'delivered'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          || (
            existing().buyerUid == request.auth.uid
            && existing().status == 'delivered'
            && incoming().status == 'completed'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
          || (
            existing().buyerUid == request.auth.uid
            && existing().status == 'completed'
            && !('rating' in existing())
            && 'rating' in incoming()
            && incoming().status == 'completed'
            && incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'updatedAt'])
