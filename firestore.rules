    match /clans/{clanId} {
      allow get: if isSignedIn() && isValidId(clanId) && (resource == null || resource.data.isPublic == true || resource.data.ownerUid == request.auth.uid || isAdmin() || exists(/databases/$(database)/documents/clans/$(clanId)/members/$(request.auth.uid)));
      allow list: if isSignedIn() && (resource.data.isPublic == true || resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(clanId)
        && isValidClan(incoming())
