          || (
            'isGroup' in existing() && existing().isGroup == true
            && (existing().creatorUid == request.auth.uid || isAdmin())
            && incoming().diff(existing()).affectedKeys().hasOnly(['participants', 'participantTags', 'groupName', 'lastMessage', 'updatedAt'])
          )
          || (
            'isGroup' in existing() && existing().isGroup == true
            && !(request.auth.uid in incoming().participants)
            && incoming().participants.size() == existing().participants.size() - 1
            && existing().participants.hasAll(incoming().participants)
            && incoming().diff(existing()).affectedKeys().hasOnly(['participants', 'participantTags', 'lastMessage', 'updatedAt'])
          )
        );
      allow delete: if isVerified() && isValidId(threadId) && (isAdmin() || ('isGroup' in existing() && existing().isGroup == true && existing().creatorUid == request.auth.uid));

