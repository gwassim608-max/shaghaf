      allow delete: if isVerified() && isValidId(clanId) && (existing().ownerUid == request.auth.uid || isAdmin());

      match /members/{memberUid} {
        allow get: if isSignedIn() && isValidId(clanId) && isValidId(memberUid) && existing().uid is string;
        allow list: if isSignedIn() && resource.data.uid is string;
        allow create: if isVerified() && isValidId(clanId) && isValidId(memberUid)
          && isValidClanMember(incoming())
          && incoming().joinedAt == request.time
          && exists(/databases/$(database)/documents/clans/$(clanId))
          && (
            (memberUid == request.auth.uid && incoming().uid == request.auth.uid && incoming().role == 'member'
                && (notBanned() || isAdmin())
                && get(/databases/$(database)/documents/clans/$(clanId)).data.isPublic == true)
            || (memberUid == request.auth.uid && incoming().uid == request.auth.uid && incoming().role == 'owner'
                && get(/databases/$(database)/documents/clans/$(clanId)).data.ownerUid == request.auth.uid)
