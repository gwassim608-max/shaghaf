    match /bot_messages/{targetUid}/items/{msgId} {
      allow get: if isVerified() && isValidId(targetUid) && isValidId(msgId) && (resource == null || request.auth.uid == targetUid || isAdmin());
      allow list: if isVerified() && (resource.data.targetUid == request.auth.uid || isAdmin());
      allow create: if isVerified() && isValidId(targetUid) && isValidId(msgId)
