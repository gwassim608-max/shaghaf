        && isValidClan(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && (
          (existing().ownerUid == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'tag', 'game', 'region', 'minRank', 'description', 'isPublic', 'updatedAt']))
          || isAdmin()
